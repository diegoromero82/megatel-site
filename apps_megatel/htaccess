# ============================================
# .htaccess para Megatel SAS - Versión Optimizada 2026
# ============================================

# SEGURIDAD
Options -Indexes

<FilesMatch "\.(htaccess|htpasswd|ini|log|sql|bak|conf)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# REDIRECCIONES Y URLs AMIGABLES
RewriteEngine On
RewriteBase /

# 1. FORZAR HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. FORZAR WWW (Consistencia con Sitemap)
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 3. REDIRECCIONAR index.html a /
RewriteCond %{THE_REQUEST} ^.*/index\.html
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# 4. URLs LIMPIAS (Eliminar .html de la vista del usuario)
# Redirecciona /pagina.html a /pagina para un SEO más limpio
RewriteCond %{THE_REQUEST} ^GET\ /[^?\s]+\.html [NC]
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# Carga el archivo .html internamente cuando el usuario entra a /pagina
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# ============================================
# REDIRECCIONES 301 ESPECÍFICAS (Mantenimiento SEO)
# ============================================

# Antiguos enlaces de WordPress a nueva estructura
Redirect 301 /net2phone-central-virtual-en-la-nube/ https://www.megatelsas.com/telefonia.html
Redirect 301 /industria-hotelera/ https://www.megatelsas.com/
Redirect 301 /contacto/ https://www.megatelsas.com/contacto
Redirect 301 /morbi-ut-felis-ornare-vel/ https://www.megatelsas.com/

# Limpieza de rastros de WordPress
RedirectMatch 301 ^/author/.* https://www.megatelsas.com/
RedirectMatch 301 ^/comments/.* https://www.megatelsas.com/
RedirectMatch 301 ^/feed/.* https://www.megatelsas.com/
RedirectMatch 301 ^/sg_form/.* https://www.megatelsas.com/contacto

# Bloquear búsquedas internas antiguas
RewriteCond %{QUERY_STRING} ^s=
RewriteRule .* https://www.megatelsas.com/? [R=301,L]

# ============================================
# RENDIMIENTO Y CACHÉ
# ============================================

# Compresión GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml image/svg+xml image/x-icon
</IfModule>

# Browser Caching (Expires Headers)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# SEGURIDAD ADICIONAL (Headers)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# PROTECCIÓN CONTRA HOTLINK (Corregido a megatelsas.com)
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https://(www\.)?megatelsas\.com [NC]
RewriteRule \.(jpg|jpeg|png|gif|webp|svg)$ - [F,L]

# PÁGINAS DE ERROR
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

AddDefaultCharset UTF-8